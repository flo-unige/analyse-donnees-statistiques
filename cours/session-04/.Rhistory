flag <- 1
for (i in seq(110, 150, 5)) {
for (j in seq(-40, -10, 5)) {
climate_avg_temp <- get_power(community = "AG",
pars = "PRECTOTCORR",
lonlat = c(i, (j - 5), (i + 5), j),
temporal_api = "CLIMATOLOGY")
if (flag == 1) {
climate_avg <- climate_avg_temp
flag <- 0
} else{
climate_avg <- rbind(climate_avg, climate_avg_temp)
}
}
}
