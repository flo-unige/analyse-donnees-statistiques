# Matrice 1 : 100 x 9 (ID x SDV), remplie aléatoirement de 0 et 1
mat1 <- matrix(
sample(c(0, 1), size = n_id * n_sdv, replace = TRUE),
nrow = n_id,
ncol = n_sdv
)
# Pour reproductibilité
set.seed(123)
# Pour reproductibilité
set.seed(123)
# Dimensions
n_id  <- 100   # lignes de la matrice 1
n_sdv <- 9     # colonnes de la matrice 1 / lignes de la matrice 2
n_nbs <- 50    # colonnes de la matrice 2
# Matrice 1 : 100 x 9 (ID x SDV), remplie aléatoirement de 0 et 1
mat1 <- matrix(
sample(c(0, 1), size = n_id * n_sdv, replace = TRUE),
nrow = n_id,
ncol = n_sdv
)
# Matrice 2 : 9 x 50 (SDV x NBS), remplie aléatoirement de 0 et 1
mat2 <- matrix(
sample(c(0, 1), size = n_sdv * n_nbs, replace = TRUE),
nrow = n_sdv,
ncol = n_nbs
)
# Noms optionnels
rownames(mat1) <- paste0("ID_", 1:n_id)
colnames(mat1) <- paste0("SDV_", 1:n_sdv)
rownames(mat2) <- paste0("SDV_", 1:n_sdv)
colnames(mat2) <- paste0("NBS_", 1:n_nbs)
# Multiplication matricielle
mat_result <- mat1 %*% mat2
# Vérification des dimensions
dim(mat1)        # 100  9
dim(mat2)        # 9  50
dim(mat_result)  # 100 50
# Afficher un aperçu
head(mat_result)
View(mat1)
View(mat2)
View(mat_result)
heatmap(
mat_result,
Rowv = NA,
Colv = NA,
scale = "none",
col = heat.colors(20),
margins = c(6, 8),
main = "Heatmap de la matrice finale"
)
heatmap(
mat_result,
Rowv = NA,
Colv = NA,
scale = "none",
col = heat.colors(20),
margins = c(6, 8),
main = "Heatmap de la matrice finale"
)
